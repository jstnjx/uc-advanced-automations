{
  "settings": {
    "core_url": "ws://remote.local/ws",
    "api_key": "",
    "web_host": "0.0.0.0",
    "web_port": 8099,
    "timezone": "Europe/Berlin",
    "request_timeout_seconds": 10
  },
  "automations": [
    {
      "id": "movie-night",
      "name": "Movie Night",
      "command": "MOVIE_NIGHT",
      "command_enabled": true,
      "description": "Starts when selected on the Remote or when the TV changes from OFF to ON.",
      "enabled": true,
      "mode": "single",
      "triggers": [
        {
          "id": "tv-on-trigger",
          "type": "entity_state",
          "enabled": true,
          "entity_id": "media_player.tv",
          "attribute": "state",
          "from_value": "OFF",
          "to_value": "ON",
          "debounce_ms": 500,
          "cooldown_ms": 5000
        }
      ],
      "steps": [
        {
          "type": "command",
          "entity_id": "switch.living_room_power",
          "cmd_id": "switch.on",
          "params": {}
        },
        {
          "type": "delay",
          "milliseconds": 1500
        },
        {
          "type": "command",
          "entity_id": "media_player.tv",
          "cmd_id": "media_player.select_source",
          "params": {
            "source": "HDMI 1"
          }
        }
      ]
    }
  ]
}
